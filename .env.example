# GovSaarthi Configuration

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security
SECRET_KEY=govsaarthi-nesfic2026-secret-key-change-in-prod-secure-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL with pgvector)
# If Postgres is unreachable, GovSaarthi automatically falls back to SQLite + vector search seamlessly!
DATABASE_URL=postgresql://govsaarthi_user:govsaarthi_password@localhost:5432/govsaarthi_db
# SQLite Fallback: sqlite:///./govsaarthi.db

# LLM & Embedding Provider
# Supported: groq (fastest, free tier), gemini, openai, local-rag (offline fallback)

# Option A: Groq (Recommended for lightning fast 500+ tokens/sec responses)
LLM_PROVIDER=groq
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
# Alternative Groq models: llama-3.1-8b-instant, qwen-qwq-32b

# Option B: Google Gemini
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.5-flash

# Option C: OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Embeddings Configuration
# Option 1: Jina AI (Recommended: 8192 token context, perfect for lengthy legal/gazette sections, 1M free tokens)
# EMBEDDING_PROVIDER=jina
# JINA_API_KEY=jina_your_api_key_here

# Option 2: Local Built-in (Default: zero external dependency, 100% offline fail-safe)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# RAG Thresholds
RELEVANCE_SIMILARITY_THRESHOLD=0.35
TOP_K_CHUNKS=5
CHUNK_SIZE=700
CHUNK_OVERLAP=150
